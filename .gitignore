# Generated by scripts/build-corpus.ts. Rebuild with: npx tsx scripts/build-corpus.ts
corpus/

# Generated by scripts/build-corpus.ts at prebuild; published to Pages, never committed.
public/assistant/
# ...except this one. It is generated, but NOT reproducible from the repository: it comes
# from fetching 252 public instruments over about half an hour, and the fetched text is not
# committed. CI cannot rebuild it, so without this the live site loses the instruments and
# only the guide is searchable.
!public/assistant/instruments.json
!public/assistant/sources.json

# Local secrets. The model key belongs here, never in a VITE_ variable:
# a VITE_ prefix ships the value to every visitor.
.env
.env.local
.env.*.local
